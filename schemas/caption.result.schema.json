{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "caption result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "kind",
    "source_code",
    "sheet_row",
    "type",
    "variants",
    "notes"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^CAP-[0-9]{8}-[0-9]{3}$"
    },
    "kind": {
      "const": "caption"
    },
    "source_code": {
      "type": "string"
    },
    "sheet_row": {
      "type": "integer",
      "minimum": 2
    },
    "type": {
      "enum": [
        "group",
        "wall"
      ]
    },
    "image_link": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "angle",
          "caption"
        ],
        "properties": {
          "angle": {
            "type": "string",
            "maxLength": 80
          },
          "caption": {
            "type": "string",
            "minLength": 120,
            "maxLength": 1200
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}